{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with wealth level, charm level, and balances",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "countryFlag": { "type": "string" },
        "wealthLevel": { "type": "number" },
        "charmLevel": { "type": "number" },
        "coins": { "type": "number" },
        "diamonds": { "type": "number" },
        "points": { "type": "number" },
        "xp": { "type": "number" },
        "vipTier": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "WalletTransaction": {
      "title": "Wallet Ledger Entry",
      "description": "Ledger entry for coin, diamond, and point movements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "currency", "description", "timestamp"]
    },
    "Stream": {
      "title": "Live Broadcast Room",
      "description": "Live stream or 9-seat party room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hostName": { "type": "string" },
        "hostAvatar": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "mode": { "type": "string" },
        "viewerCount": { "type": "number" },
        "countryFlag": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "hostName", "title", "category", "status"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Stream chat or direct message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "roomId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "senderId", "senderName", "text", "roomId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/WalletTransaction" },
      "description": "Wallet transaction ledger"
    },
    "/streams/{streamId}": {
      "schema": { "$ref": "#/entities/Stream" },
      "description": "Live stream rooms"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Live and direct messages"
    }
  }
}
